import os
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

from models import (Base, Character, PlanetLocation, Starship, ShipClass, HoloRecord,
                    Bid, RepublicCredit, SpiceBarter, Spaceport, DockingBay,
                    SmugglerFaction, TransportMission)
from queries import run_all_queries
from graph_db import SmugglerGraph
from polyglot import auction_trust_check, recommend_mission_crew

# ---------------------------------------------------------------
# NEO4J-VERBINDUNG  (Platzhalter -> in README beschrieben / per Env setzbar)
# ---------------------------------------------------------------
NEO4J_URI      = os.getenv("NEO4J_URI", "bolt://localhost:7687")
NEO4J_USER     = os.getenv("NEO4J_USER", "neo4j")
NEO4J_PASSWORD = os.getenv("NEO4J_PASSWORD", "password")   # <-- HIER eigenes Passwort eintragen

SOCIAL_FILE = os.path.join(os.path.dirname(__file__), "input_files", "social_network.json")


def populate_db(session):
    print("Befuelle die relationale Datenbank mit Star-Wars-Mock-Daten...")

    # 1. Characters (Aufgabe 1 + Erweiterung fuer das Graph-Netzwerk)
    han   = Character(name="Han Solo")
    luke  = Character(name="Luke Skywalker")
    lando = Character(name="Lando Calrissian")
    boba  = Character(name="Boba Fett")
    chewie = Character(name="Chewbacca")
    qira   = Character(name="Qi'ra")
    bossk  = Character(name="Bossk")
    dengar = Character(name="Dengar")
    greedo = Character(name="Greedo")
    maz    = Character(name="Maz Kanata")

    # 2. Locations (Sektor wird in Polyglot-Abfrage 2 genutzt)
    tatooine  = PlanetLocation(planet_name="Tatooine",  sector="Outer Rim",   character=luke)
    coruscant = PlanetLocation(planet_name="Coruscant", sector="Core Worlds", character=han)
    bespin    = PlanetLocation(planet_name="Bespin",    sector="Outer Rim",   character=lando)
    kamino    = PlanetLocation(planet_name="Kamino",    sector="Outer Rim",   character=boba)
    trandosha = PlanetLocation(planet_name="Trandosha", sector="Outer Rim",   character=bossk)
    tatooine2 = PlanetLocation(planet_name="Tatooine",  sector="Outer Rim",   character=dengar)
    rodia     = PlanetLocation(planet_name="Rodia",     sector="Outer Rim",   character=greedo)
    corellia  = PlanetLocation(planet_name="Corellia",  sector="Core Worlds", character=qira)
    kashyyyk  = PlanetLocation(planet_name="Kashyyyk",  sector="Mid Rim",     character=chewie)
    takodana  = PlanetLocation(planet_name="Takodana",  sector="Outer Rim",   character=maz)

    # 3. Payment Methods
    han_credits   = RepublicCredit(account_balance=50000.0,  character=han)
    lando_credits = RepublicCredit(account_balance=950000.0, character=lando)
    luke_spice    = SpiceBarter(spice_type="Kessel", kilos=5.5, character=luke)
    boba_credits  = RepublicCredit(account_balance=150000.0, character=boba)
    qira_credits  = RepublicCredit(account_balance=300000.0, character=qira)
    dengar_credits = RepublicCredit(account_balance=80000.0, character=dengar)

    # 4. Ship Classes
    freighter   = ShipClass(class_name="Light Freighter")
    fighter     = ShipClass(class_name="Starfighter")
    interceptor = ShipClass(class_name="Interceptor")

    # 5. Starships
    falcon = Starship(model_name="Millennium Falcon", seller=han,  ship_classes=[freighter])
    xwing  = Starship(model_name="X-Wing T-65",        seller=luke, ship_classes=[fighter])
    slave1 = Starship(model_name="Firespray-31 (Slave I)", seller=boba, ship_classes=[freighter, interceptor])

    # 6. Holo Records
    holo1 = HoloRecord(file_path="/holonet/falcon_front.holo", resolution="1080p", starship=falcon)
    holo2 = HoloRecord(file_path="/holonet/xwing_engine.holo", resolution="720p",  starship=xwing)

    # 7. Bids  (Boba bietet am hoechsten auf den Falcon -> wird in Polyglot 1 relevant)
    bid1 = Bid(amount=100000, bidder=luke,  starship=falcon)
    bid2 = Bid(amount=120000, bidder=lando, starship=falcon)
    bid3 = Bid(amount=50000,  bidder=han,   starship=xwing)
    bid4 = Bid(amount=200000, bidder=lando, starship=slave1)
    bid5 = Bid(amount=215000, bidder=han,   starship=slave1)
    bid6 = Bid(amount=130000, bidder=boba,  starship=falcon)

    # 8. Spaceports, Bays & Factions
    mos_eisley     = Spaceport(name="Mos Eisley Spaceport")
    cloud_city_port = Spaceport(name="Cloud City Platform")
    bay94  = DockingBay(bay_number="94",  spaceport=mos_eisley)
    bay327 = DockingBay(bay_number="327", spaceport=cloud_city_port)
    hutt_cartel    = SmugglerFaction(name="Hutt Cartel")
    pyke_syndicate = SmugglerFaction(name="Pyke Syndicate")

    # 9. Transport Missions
    mission1 = TransportMission(tracking_code="Kessel-Run-12",     destination=tatooine,  origin_spaceport=mos_eisley,     factions=[hutt_cartel])
    mission2 = TransportMission(tracking_code="Bespin-Drop-01",    destination=bespin,    origin_spaceport=cloud_city_port, factions=[hutt_cartel, pyke_syndicate])
    mission3 = TransportMission(tracking_code="Coruscant-Express", destination=coruscant, origin_spaceport=mos_eisley,     factions=[pyke_syndicate])

    session.add_all([han, luke, lando, boba, chewie, qira, bossk, dengar, greedo, maz,
                     tatooine, coruscant, bespin, kamino, trandosha, tatooine2, rodia,
                     corellia, kashyyyk, takodana,
                     han_credits, lando_credits, luke_spice, boba_credits, qira_credits, dengar_credits,
                     freighter, fighter, interceptor, falcon, xwing, slave1,
                     holo1, holo2, bid1, bid2, bid3, bid4, bid5, bid6,
                     mos_eisley, cloud_city_port, bay94, bay327,
                     hutt_cartel, pyke_syndicate, mission1, mission2, mission3])
    session.commit()
    print("Relationale Datenbank erfolgreich befuellt!\n")


def run_graph_and_polyglot(session):
    """Baut den Neo4j-Graphen und fuehrt die 3 Graph- + 2 Polyglot-Abfragen aus."""
    graph = SmugglerGraph(NEO4J_URI, NEO4J_USER, NEO4J_PASSWORD)
    try:
        graph.clear()
        graph.build_from_relational(session, SOCIAL_FILE)

        print("\n" + "=" * 64)
        print("GRAPH-DB ABFRAGEN (Neo4j)")
        print("=" * 64)

        print("\n--- GRAPH 1: Vertrauenswuerdigste Schmuggler ---")
        for r in graph.most_trusted_smugglers(limit=5):
            print(f"  {r['smuggler']:<18} vertraut von {r['trusted_by']} "
                  f"| Trust-Score {r['trust_score']}")

        print("\n--- GRAPH 2: Kuerzeste Vertrauenskette Luke -> Boba Fett ---")
        path = graph.trust_path("Luke Skywalker", "Boba Fett")
        if path:
            print(f"  {' -> '.join(path['chain'])}  ({path['hops']} Schritte)")
        else:
            print("  Keine Vertrauenskette gefunden.")

        print("\n--- GRAPH 3: Partner-Empfehlung fuer Han Solo ---")
        for r in graph.recommend_partners("Han Solo"):
            print(f"  {r['recommended']:<14} ueber {r['via']} "
                  f"(gemeinsame Kontakte: {r['mutual_contacts']})")

        print("\n" + "=" * 64)
        print("POLYGLOT-ABFRAGEN (SQLite + Neo4j)")
        print("=" * 64)
        auction_trust_check(session, graph, "Millennium Falcon")
        recommend_mission_crew(session, graph, "Kessel-Run-12")

    finally:
        graph.close()


if __name__ == "__main__":
    engine = create_engine('sqlite:///:memory:', echo=False)
    Base.metadata.create_all(engine)
    Session = sessionmaker(bind=engine)
    session = Session()

    # 1. Relationale Daten erzeugen
    populate_db(session)

    # 2. Relationale Abfragen (Aufgabe 1/2)
    run_all_queries(session)

    # 3. Graph- und Polyglot-Abfragen (Aufgabe 4)
    try:
        run_graph_and_polyglot(session)
    except Exception as exc:
        print("\n[Hinweis] Neo4j ist nicht erreichbar - Graph-Teil uebersprungen.")
        print(f"          Bitte Neo4j starten (siehe README.md). Details: {exc}")
